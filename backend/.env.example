# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000

# Exact browser origins allowed to call this API in production (comma-separated).
# Localhost origins are enabled automatically outside production.
ALLOWED_ORIGINS=https://your-school-domain.example

# Required to authorize the scheduled /api/cron/daily endpoint on Vercel.
# Set the same random secret in the Vercel project environment.
CRON_SECRET=replace_with_a_random_secret_at_least_16_characters

# ── Database ──────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string
# Create a database user and allow your development IP in Atlas first.
# URL-encode special characters in the username or password.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/school_system_uganda?retryWrites=true&w=majority

# ── Authentication ────────────────────────────────────────────────────────────
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_strong_random_secret
JWT_REFRESH_SECRET=replace_with_another_strong_random_secret
# Set to true only during the one-time creation of the first administrator.
ALLOW_INITIAL_ADMIN_SETUP=false

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,https://yourdomain.com

# ── Email (Nodemailer / SMTP) ─────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
ALERT_FROM=alerts@ndugu.academy

# ── Africa's Talking (SMS) ────────────────────────────────────────────────────
AT_API_KEY=your_africas_talking_api_key
AT_USERNAME=your_africas_talking_username
AT_ENVIRONMENT=sandbox

# ── MTN MoMo Collections ──────────────────────────────────────────────────────
# Create an API user and subscription key in the MTN MoMo Developer Portal.
# Keep sandbox credentials separate from production credentials.
MTN_MOMO_SUBSCRIPTION_KEY=your_mtn_subscription_key
MTN_MOMO_API_USER=your_mtn_api_user_uuid
MTN_MOMO_API_KEY=your_mtn_api_key
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_TARGET_ENVIRONMENT=sandbox
MTN_MOMO_CURRENCY=UGX
# Must be the public HTTPS URL of POST /api/finance/momo/callback
MTN_MOMO_CALLBACK_URL=https://yourdomain.com/api/finance/momo/callback

# ── Inventory Alerts ─────────────────────────────────────────────────────────
# Phone number to receive low-stock SMS alerts (Uganda format: +256...)
INVENTORY_ALERT_PHONE=+256700000000

# ── Frontend URL (used in email links) ───────────────────────────────────────
FRONTEND_URL=https://yourdomain.com

# ── HR Module ─────────────────────────────────────────────────────────────────
# Default annual leave days for new staff profiles
HR_DEFAULT_ANNUAL_LEAVE=21
HR_DEFAULT_SICK_LEAVE=10
