{
  "version": 2,
  "buildCommand": "npm run build --prefix web",
  "outputDirectory": "web/dist",
  "installCommand": "npm install && npm install --prefix web",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 3 * * *"
    }
  ]
}
