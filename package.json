{
  "name": "school-system-uganda",
  "version": "1.0.0",
  "description": "School Management System root workspace",
  "scripts": {
    "start": "node scripts/start-dev.js",
    "dev": "node scripts/start-dev.js",
    "start:backend": "npm run dev --prefix backend",
    "start:web": "npm --prefix web run dev",
    "start:mobile": "npm run start --prefix mobile",
    "install:all": "npm install && npm install --prefix backend && npm install --prefix web && npm install --prefix mobile"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
